# Rust build output
/target

# CForge transpilation output
/dist

# Packaging staging area
/packaging

# Tokenizer / parser debug logs
*.log
cforge_tokenizer_debug.log

# Local agent / IDE state
/.claude

# Python bytecode cache
__pycache__/
*.pyc

# VSCode extension build artifacts (see scripts/install_extensions.py)
/editors/**/node_modules/
/editors/**/out/
/editors/**/*.vsix
# Explicit (belt-and-suspenders) — never track the extension's deps/build.
/editors/vscode/node_modules/
/editors/vscode/out/

# Installer GUI — the MUI installer SOURCE (installer.mui, backend.rs,
# app.bundle, assets) is committed; the copper-installer host crate is
# NOT tracked (local-only / generated).
/installer-gui/dist/
/installer-gui/copper-installer/

# lson submodule build output (lson-src/ has its own .gitignore, but be explicit)
lson-src/target/
