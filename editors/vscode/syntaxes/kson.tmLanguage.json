{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "KSON",
  "scopeName": "source.kson",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#sections" },
    { "include": "#keys" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#constants" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.number-sign.kson", "match": "#.*$" }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "comment": "Directives like @env(USER_TOKEN).",
          "match": "(@[A-Za-z_][A-Za-z0-9_]*)\\s*(\\()?",
          "captures": {
            "1": { "name": "entity.name.function.decorator.kson" },
            "2": { "name": "punctuation.section.parens.kson" }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "comment": "Section header, e.g. $dependencies.",
          "name": "entity.name.tag.section.kson",
          "match": "^\\s*(\\$[A-Za-z_][A-Za-z0-9_]*)"
        }
      ]
    },
    "keys": {
      "patterns": [
        {
          "comment": "A key on the left of `=`.",
          "match": "^\\s*([A-Za-z_][A-Za-z0-9_.\\-]*)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.key.kson" },
            "2": { "name": "keyword.operator.assignment.kson" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kson",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.kson", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.kson",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.kson",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.kson", "match": "=" }
      ]
    }
  }
}
