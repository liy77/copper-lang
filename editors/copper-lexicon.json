{
  "$comment": "SINGLE SOURCE OF TRUTH for Copper keyword + primitive-type descriptions. Read by BOTH the copper-lsp server (embedded via include_str! in src/lexicon.rs) and the MUI/CRM VS Code extension (read at runtime). Editing a description here updates both — they can never drift. Mocida/MUI-specific items (view, signal, computed, effect) are NOT Copper keywords and live in the MUI extension's own catalog, not here.",
  "keywords": [
    { "name": "func", "detail": "func RetType name(params)", "doc": "Declares a function." },
    { "name": "mut", "detail": "mut name = value", "doc": "Declares a mutable variable." },
    { "name": "let", "detail": "let name = value", "doc": "Declares an immutable variable." },
    { "name": "if", "detail": "if cond { ... } else { ... }", "doc": "Conditional branch." },
    { "name": "else", "detail": "else { ... }", "doc": "Else branch." },
    { "name": "match", "detail": "match x { pattern => result }", "doc": "Pattern matching." },
    { "name": "for", "detail": "for x in iter { ... }", "doc": "Iterates over a sequence." },
    { "name": "while", "detail": "while cond { ... }", "doc": "Loops while a condition holds." },
    { "name": "loop", "detail": "loop { ... }", "doc": "Infinite loop; exit with break." },
    { "name": "break", "detail": "break", "doc": "Exit loop." },
    { "name": "continue", "detail": "continue", "doc": "Skip iteration." },
    { "name": "return", "detail": "return value", "doc": "Return from function." },
    { "name": "struct", "detail": "struct Name { field: Type }", "doc": "Defines a structure." },
    { "name": "class", "detail": "class Name { ... }", "doc": "Defines a class with methods." },
    { "name": "impl", "detail": "impl Type { ... }", "doc": "Implementation block for a type." },
    { "name": "trait", "detail": "trait Name { ... }", "doc": "Defines a trait (shared behavior)." },
    { "name": "enum", "detail": "enum Name { Variant, ... }", "doc": "Defines an enumeration type." },
    { "name": "import", "detail": "import { items } from module", "doc": "Imports items from a module." },
    { "name": "from", "detail": "import x from module", "doc": "Module path in `import`." },
    { "name": "as", "detail": "import x as y from module", "doc": "Rename an import or cast a value." },
    { "name": "pub", "detail": "pub func / pub struct …", "doc": "Public visibility — exports the item from its module." },
    { "name": "public", "detail": "public func / public struct …", "doc": "Public visibility (alias for `pub`)." },
    { "name": "unsafe", "detail": "unsafe { ... } / unsafe func …", "doc": "Marks code or a function whose safety the compiler can't verify." },
    { "name": "const", "detail": "const NAME: Type = value", "doc": "Compile-time constant." },
    { "name": "static", "detail": "static NAME: Type = value", "doc": "Program-lifetime static value." },
    { "name": "async", "detail": "async func ...", "doc": "Declares an asynchronous function or block." },
    { "name": "await", "detail": "expr await", "doc": "Awaits an async value." },
    { "name": "extern", "detail": "extern \"C\" { ... }", "doc": "Links to or exports a foreign (C ABI) function." },
    { "name": "dyn", "detail": "dyn Trait", "doc": "A dynamically-dispatched trait object." },
    { "name": "ref", "detail": "ref name", "doc": "Binds by reference in a pattern." },
    { "name": "move", "detail": "move |args| ...", "doc": "Moves captured variables into a closure." },
    { "name": "where", "detail": "where T: Trait", "doc": "Adds bounds to a generic declaration." },
    { "name": "yield", "detail": "yield value", "doc": "Yields a value from a generator." },
    { "name": "in", "detail": "for x in iter", "doc": "Separates the loop variable from its iterator." },
    { "name": "true", "detail": "true", "doc": "Boolean literal." },
    { "name": "false", "detail": "false", "doc": "Boolean literal." }
  ],
  "types": [
    { "name": "int", "detail": "int", "doc": "64-bit signed integer (alias for i64)." },
    { "name": "float", "detail": "float", "doc": "64-bit floating point (alias for f64)." },
    { "name": "string", "detail": "string", "doc": "Owned UTF-8 string (alias for String)." },
    { "name": "bool", "detail": "bool", "doc": "Boolean (true or false)." }
  ]
}
