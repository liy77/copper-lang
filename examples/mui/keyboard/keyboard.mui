// keyboard.mui — keyboard input with `onKeyInput`.
//
// Any widget can take an `onKeyInput` handler. Keyboard events aren't spatial
// (there's no "hover" for keys), so it fires on EVERY key press for every
// widget that declared one — the handler decides which key matters by checking
// `event.key`. The key name is SDL's: "A".."Z", "0".."9", "Up"/"Down"/"Left"/
// "Right", "Space", "Return", "Escape", "Tab", "Backspace", …
//
// The handler is an inline block `{ |event| … }`: `event.key` is the pressed
// key, and the body may run signal mutations (`= += -= ++ --`) inside
// `if`/`else if` branches. Here the root Stack drives everything:
//   Up / W    → score + 1
//   Down / S  → score - 1
//   R         → reset to 0
//   Space     → big bonus (+10)
//
// Run it:  cforge run examples/mui/keyboard/keyboard.mui

app {
  name: "Keyboard Input"
  width: 520
  height: 380
  background: #0f172a
  entry: Demo
}

view Demo() {
  mut score = signal(0)

  Stack(
    orientation: vertical,
    gap: 18,
    padding: 32,
    align: center,
    onKeyInput: { |event| 
        if event.key == "Up" { 
          score += 1 
        } else if event.key == "W" { 
          score += 1 
        } else if event.key == "Down" { 
          score -= 1 
        } else if event.key == "S" { 
          score -= 1 
        } else if event.key == "Space" {
           score += 10 
        } else if event.key == "R" { 
          score = 0 
        } 

        println!("Key pressed: {}", event.key)
      },
  ) {
    Text("Keyboard input", size: 22, color: #e2e8f0, weight: bold)

    // The score reacts live — `${score}` re-renders whenever the handler
    // mutates the signal.
    Stack(orientation: vertical, gap: 4, align: center, background: #1e293b, radius: 14, padding: 24) {
      Text("score", size: 13, color: #64748b)
      Text("${score}", size: 48, color: #38bdf8, weight: bold, align: center)
    }

    // A bit of color-coded feedback driven by the same signal (structural `if`,
    // so it rebuilds when the branch flips).
    if score >= 10 {
      Text("nice run!", size: 14, color: #22c55e, weight: bold)
    } else if score < 0 {
      Text("below zero", size: 14, color: #f87171)
    } else {
      Text("keep going", size: 14, color: #94a3b8)
    }

    Text("Up/W +1    Down/S -1    Space +10    R reset", size: 12, color: #475569)
  }
}
