// `http` — HTTP/HTTPS client (TLS via the bundled `ureq` crate).
// Request functions return a rich `Response` (status / body / ok / json).
import { get, post_json, download } from http

// HTTPS GET — the response is a Response object.
r = get("https://example.com")
println!("status = {}", r.status)
println!("body   = {} bytes", r.body.len())
println!("ok     = {}", r.is_ok())

// POST a JSON payload; read a field straight out of the JSON reply.
reply = post_json("https://httpbin.org/post", "{\"hello\":\"copper\"}")
println!("post status = {}", reply.status)
println!("post echo   = {}", reply.json("json.hello"))

// Stream a URL straight to disk.
saved = download("https://example.com", "example.html")
println!("downloaded = {}", saved)
