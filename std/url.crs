// Copper `url` standard library — URL percent-encoding and helpers.
//
// Loaded via `import { ... } from url`. Pure Rust std, no dependencies.
// Bundled as `pub mod url { ... }` with std/url_native.rs.
//
// Public surface (implemented in std/url_native.rs):
//
//   url::encode(s)            -> percent-encode for a query component
//   url::decode(s)            -> reverse percent-encoding (+ and %XX)
//   url::encode_component(s)  -> stricter encode (also encodes / ? & = etc.)
//   url::query2(k1,v1,k2,v2)  -> "k1=v1&k2=v2" with both sides encoded
//   url::join(base, path)     -> join a base URL and a path, fixing slashes

// Return the upper-hex character for a nibble (0..=15).
func char hex_digit_char(n: u8) {
    if n <= 9 {
        return (b'0' + n) as char
    }
    return (b'A' + (n - 10)) as char
}

// Decode a single hex ASCII byte to its numeric value, or None.
func Option<u8> hex_val(b: u8) {
    if b >= b'0' && b <= b'9' {
        return Some(b - b'0')
    }
    if b >= b'a' && b <= b'f' {
        return Some(b - b'a' + 10)
    }
    if b >= b'A' && b <= b'F' {
        return Some(b - b'A' + 10)
    }
    return None
}

// RFC 3986 unreserved characters: A-Z a-z 0-9 - _ . ~
// ASCII: 45='-', 95='_', 46='.', 126='~'
func bool is_unreserved(b: u8) {
    return (b >= b'A' && b <= b'Z') || (b >= b'a' && b <= b'z') || (b >= b'0' && b <= b'9') || b == 45u8 || b == 95u8 || b == 46u8 || b == 126u8
}

// Core encoder: keep unreserved bytes, optionally encode space as '+',
// everything else as %XX (uppercase hex).
// ASCII: 32=' ', 43='+', 37='%'
func String encode_with(s: &str, space_as_plus: bool) {
    mut out = String::with_capacity(s.len() * 3)
    for b in s.as_bytes().iter().copied() {
        if is_unreserved(b) {
            out.push(b as char)
        } else if b == 32u8 && space_as_plus {
            out.push(43u8 as char)
        } else {
            out.push(37u8 as char)
            out.push(hex_digit_char(b >> 4))
            out.push(hex_digit_char(b & 0x0F))
        }
    }
    return out
}

/// Percent-encode a query value: keep the RFC 3986 unreserved set
/// (A-Z a-z 0-9 - _ . ~), encode everything else as %XX. Spaces become
/// %20 (not `+`) so the output is valid in both path and query positions.
func String encode(s: &str) {
    return encode_with(s, false)
}

/// Stricter form for a single component — same as `encode` (the unreserved
/// set already excludes `/ ? & = #`, so they are encoded). Kept as a
/// distinct name for intent at call sites.
func String encode_component(s: &str) {
    return encode_with(s, false)
}

/// Reverse percent-encoding: `%XX` -> byte, `+` -> space. Invalid `%`
/// sequences are passed through literally. Output is lossy-UTF-8.
/// ASCII: 37='%', 43='+', 32=' '
func String decode(s: &str) {
    mut bytes = s.as_bytes()
    mut out: Vec<u8> = Vec::with_capacity(bytes.len())
    mut i: usize = 0
    while i < bytes.len() {
        mut b = bytes[i]
        if b == 37u8 && i + 2 < bytes.len() {
            mut b1 = bytes[i + 1]
            mut b2 = bytes[i + 2]
            mut hi = hex_val(b1)
            mut lo = hex_val(b2)
            if let Some(h) = hi {
                if let Some(l) = lo {
                    out.push((h << 4) | l)
                    i += 3
                } else {
                    out.push(37u8)
                    i += 1
                }
            } else {
                out.push(37u8)
                i += 1
            }
        } else if b == 43u8 {
            out.push(32u8)
            i += 1
        } else {
            out.push(b)
            i += 1
        }
    }
    return String::from_utf8_lossy(&out).into_owned()
}

/// Build a two-pair query string `k1=v1&k2=v2`, encoding every key/value.
/// A blank key is skipped, so passing one pair (and two empty args) yields
/// a single-pair query.
func String query2(k1: &str, v1: &str, k2: &str, v2: &str) {
    mut parts: Vec<String> = Vec::new()
    if !k1.is_empty() {
        parts.push(format!("{}={}", encode(k1), encode(v1)))
    }
    if !k2.is_empty() {
        parts.push(format!("{}={}", encode(k2), encode(v2)))
    }
    return parts.join("&")
}

/// Join a base URL and a path with exactly one `/` between them.
/// ASCII: 47='/'
func String join(base: &str, path: &str) {
    mut slash_char: char = 47u8 as char
    mut b = base.trim_end_matches(slash_char)
    mut p = path.trim_start_matches(slash_char)
    return format!("{b}/{p}")
}
