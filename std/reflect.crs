// Copper `reflect` standard library — real runtime reflection.
//
// `import { Reflected, Value } from reflect`. Pure Rust std, no dependencies.
// Bundled as `pub mod reflect { ... }`.
//
// Importing `reflect` makes EVERY Copper type reflectable. cforge
// auto-generates `impl reflect::Reflect for <Struct>` for each struct, and the
// scalar / `Vec<T>` / `Option<T>` impls below cover the rest — so reflection
// is recursive and works on any value the program can hold (nested structs,
// lists of structs, optionals, scalars).
//
//   obj.reflect()        -> Reflected   (any value implementing Reflect)
//   reflect::of(&obj)    -> Reflected
//   obj.to_value()       -> Value       (any value, incl. nested as Object)
//
//   Reflected.keys()     -> [string]            field names, in declared order
//   Reflected.values()   -> [Value]             field values, in declared order
//   Reflected.fields()   -> [(string, Value)]   (name, value) pairs
//   Reflected.get(name)  -> Value?              value for a field, or null
//   Reflected.has(name)  -> bool                true if the field exists
//   Reflected.type_name()-> string             the type's name
//   Reflected.len()      -> int                 number of fields
//   Reflected.show()     -> string             human-readable rendering
//
// `Value` is an enum over the reflectable kinds:
//   Value::Int(int) | Value::Float(float) | Value::Bool(bool)
//   Value::Str(string) | Value::List([Value]) | Value::Object(Reflected)
//   | Value::Null
//
//   Value.show()         -> string             human-readable rendering
//
// A field whose type is itself a Copper struct reflects recursively as
// `Value::Object(...)`; a `Vec<T>`/`Option<T>` reflects as `List`/the inner
// value. Generic structs (`struct Box<T>`) are skipped (no impl generated).

// A reflected value of any reflectable kind.
#[derive(Clone, Debug, PartialEq)]
enum Value {
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(String),
    List(Vec<Value>),
    Object(Reflected),
    Null,
}

impl Value {
    // Human-readable rendering (recurses into lists and objects).
    func String show(&self) {
        return match self {
            Value::Int(n) => n.to_string(),
            Value::Float(f) => f.to_string(),
            Value::Bool(b) => b.to_string(),
            Value::Str(s) => s.clone(),
            Value::List(xs) => format!("[{}]", xs.iter().map(|v| v.show()).collect::<Vec<String>>().join(", ")),
            Value::Object(r) => r.show(),
            Value::Null => "null".to_string(),
        }
    }
}

// The reflected view of a value: its type name and ordered (name, value) fields.
#[derive(Clone, Debug, PartialEq)]
struct Reflected {
    type_name: String,
    fields: Vec<(String, Value)>,
}

impl Reflected {
    func Reflected new(type_name: &str, fields: Vec<(String, Value)>) {
        return Reflected { type_name: type_name.to_string(), fields }
    }
    func String type_name(&self) {
        return self.type_name.clone()
    }
    func Vec<String> keys(&self) {
        return self.fields.iter().map(|(k, _)| k.clone()).collect()
    }
    func Vec<Value> values(&self) {
        return self.fields.iter().map(|(_, v)| v.clone()).collect()
    }
    func Vec<(String, Value)> fields(&self) {
        return self.fields.clone()
    }
    func Option<Value> get(&self, name: &str) {
        return self.fields.iter().find(|(k, _)| k == name).map(|(_, v)| v.clone())
    }
    func bool has(&self, name: &str) {
        return self.fields.iter().any(|(k, _)| k == name)
    }
    func i64 len(&self) {
        return self.fields.len() as i64
    }
    func bool is_empty(&self) {
        return self.fields.is_empty()
    }
    // Human-readable rendering: `TypeName(a: 1, b: "x")`.
    func String show(&self) {
        body = self.fields.iter().map(|(k, v)| format!("{}: {}", k, v.show())).collect::<Vec<String>>().join(", ")
        return format!("{}({})", self.type_name, body)
    }
}

// Every reflectable type implements Reflect. cforge auto-generates the impl
// for each Copper struct; the impls below cover scalars and containers, so a
// field of any of these kinds reflects uniformly via `to_value()`.
trait Reflect {
    func Reflected reflect(&self)
    func Value to_value(&self)
}

impl Reflect for i64 {
    func Reflected reflect(&self) { return Reflected::new("int", vec![]) }
    func Value to_value(&self) { return Value::Int(*self) }
}
impl Reflect for i32 {
    func Reflected reflect(&self) { return Reflected::new("int", vec![]) }
    func Value to_value(&self) { return Value::Int(*self as i64) }
}
impl Reflect for f64 {
    func Reflected reflect(&self) { return Reflected::new("float", vec![]) }
    func Value to_value(&self) { return Value::Float(*self) }
}
impl Reflect for f32 {
    func Reflected reflect(&self) { return Reflected::new("float", vec![]) }
    func Value to_value(&self) { return Value::Float(*self as f64) }
}
impl Reflect for bool {
    func Reflected reflect(&self) { return Reflected::new("bool", vec![]) }
    func Value to_value(&self) { return Value::Bool(*self) }
}
impl Reflect for String {
    func Reflected reflect(&self) { return Reflected::new("string", vec![]) }
    func Value to_value(&self) { return Value::Str(self.clone()) }
}

impl<T: Reflect> Reflect for Vec<T> {
    func Reflected reflect(&self) { return Reflected::new("Vec", vec![]) }
    func Value to_value(&self) {
        return Value::List(self.iter().map(|x| x.to_value()).collect())
    }
}

impl<T: Reflect> Reflect for Option<T> {
    func Reflected reflect(&self) { return Reflected::new("Option", vec![]) }
    func Value to_value(&self) {
        return match self {
            Some(v) => v.to_value(),
            None => Value::Null,
        }
    }
}

// Reflect any value implementing `Reflect`: `reflect::of(&obj)`.
func Reflected of<T: Reflect>(value: &T) {
    return value.reflect()
}
