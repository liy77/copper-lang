// Copper `reflect` standard library — runtime reflection over Copper structs.
//
// `import { Reflected, Value } from reflect`. Pure Rust std, no dependencies.
// Bundled as `pub mod reflect { ... }` with std/reflect_native.rs.
//
// Importing `reflect` makes every Copper `struct` in the program reflectable:
// cforge auto-generates `impl reflect::Reflect for <Struct>` for each struct,
// so you can inspect its type name and fields at runtime.
//
//   obj.reflect()        -> Reflected   (method, auto-generated per struct)
//   reflect::of(&obj)    -> Reflected
//
//   Reflected.keys()     -> [string]            field names, in declared order
//   Reflected.values()   -> [Value]             field values, in declared order
//   Reflected.fields()   -> [(string, Value)]   (name, value) pairs
//   Reflected.get(name)  -> Value?              value for a field, or null
//   Reflected.has(name)  -> bool                true if the field exists
//   Reflected.type_name()-> string             the struct's name
//   Reflected.len()      -> int                 number of fields
//
// `Value` is an enum over the reflectable field kinds:
//   Value::Int(int) | Value::Float(float) | Value::Bool(bool)
//   Value::Str(string) | Value::List([Value]) | Value::Null
//
//   Value.show()         -> string             human-readable rendering
//
// MVP limitation: scalar (int/float/bool/string) and string-list fields are
// supported. Nested-struct fields are a follow-up (no `Value::from` impl yet),
// and generic structs (`struct Box<T>`) are skipped — no reflect impl is
// generated for them.

// A reflected field value. Copper scalars and string lists map directly.
#[derive(Clone, Debug, PartialEq)]
enum Value {
    Int(i64),
    Float(f64),
    Bool(bool),
    Str(String),
    List(Vec<Value>),
    Null,
}

impl Value {
    // Human-readable rendering.
    func String show(&self) {
        return match self {
            Value::Int(n) => n.to_string(),
            Value::Float(f) => f.to_string(),
            Value::Bool(b) => b.to_string(),
            Value::Str(s) => s.clone(),
            Value::List(xs) => format!("[{}]", xs.iter().map(|v| v.show()).collect::<Vec<String>>().join(", ")),
            Value::Null => "null".to_string(),
        }
    }
}

// `From` conversions for the scalar and list kinds.
impl From<i64> for Value {
    func Value from(v: i64) {
        return Value::Int(v)
    }
}

impl From<i32> for Value {
    func Value from(v: i32) {
        return Value::Int(v as i64)
    }
}

impl From<f64> for Value {
    func Value from(v: f64) {
        return Value::Float(v)
    }
}

impl From<f32> for Value {
    func Value from(v: f32) {
        return Value::Float(v as f64)
    }
}

impl From<bool> for Value {
    func Value from(v: bool) {
        return Value::Bool(v)
    }
}

impl From<String> for Value {
    func Value from(v: String) {
        return Value::Str(v)
    }
}

impl From<&str> for Value {
    func Value from(v: &str) {
        return Value::Str(v.to_string())
    }
}

impl<T: Into<Value>> From<Vec<T>> for Value {
    func Value from(v: Vec<T>) {
        return Value::List(v.into_iter().map(Into::into).collect())
    }
}

// The reflected view of a value: its type name and ordered (name, value) fields.
#[derive(Clone, Debug)]
struct Reflected {
    type_name: String,
    fields: Vec<(String, Value)>,
}

impl Reflected {
    func Reflected new(type_name: &str, fields: Vec<(String, Value)>) {
        return Reflected { type_name: type_name.to_string(), fields }
    }
    func String type_name(&self) {
        return self.type_name.clone()
    }
    func Vec<String> keys(&self) {
        return self.fields.iter().map(|(k, _)| k.clone()).collect()
    }
    func Vec<Value> values(&self) {
        return self.fields.iter().map(|(_, v)| v.clone()).collect()
    }
    func Vec<(String, Value)> fields(&self) {
        return self.fields.clone()
    }
    func Option<Value> get(&self, name: &str) {
        return self.fields.iter().find(|(k, _)| k == name).map(|(_, v)| v.clone())
    }
    func bool has(&self, name: &str) {
        return self.fields.iter().any(|(k, _)| k == name)
    }
    func i64 len(&self) {
        return self.fields.len() as i64
    }
    func bool is_empty(&self) {
        return self.fields.is_empty()
    }
}

// Implemented (auto-generated by cforge) for every Copper struct when the
// `reflect` module is imported.
trait Reflect {
    func Reflected reflect(&self)
}

// Reflect any value implementing `Reflect`: `reflect::of(&obj)`.
func Reflected of<T: Reflect>(value: &T) {
    return value.reflect()
}
