#!/usr/bin/env sh
# Pre-push hook for copper-lang. Adds the slower checks that pre-commit
# skips, so a successful push is a strong CI-green signal.
#
# To bypass in an emergency: `git push --no-verify`.

set -e

if ! command -v cargo >/dev/null 2>&1; then
    echo "[pre-push] ERROR: cargo not found in PATH"
    exit 1
fi

echo "▶ cargo test --quiet"
cargo test --quiet

echo "✅ pre-push checks passed"
